    {
      "name": "Basic Auth",
      "item": [
        {
          "name": "BasicAuth",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Check if the response status is 200 OK\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Verify that the response is JSON\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "// Check if the server confirmed authentication\r",
                  "pm.test(\"Authenticated successfully\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.authenticated).to.be.true;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "password",
                  "value": "{{basicAuth}}",
                  "type": "string"
                },
                {
                  "key": "username",
                  "value": "postman",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BaseUrl}}basic-auth",
              "host": [
                "{{BaseUrl}}basic-auth"
              ]
            }
          },
          "response": []
        }
      ],
