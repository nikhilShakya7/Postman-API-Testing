      "name": "Digest Auth",
      "item": [
        {
          "name": "DigestAuth",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Digest Auth successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Validate response time to ensure the handshake was efficient",
                  "pm.test(\"Response time is less than 800ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(800);",
                  "});",
                  "",
                  "// Ensure the correct algorithm was used (referenced in your JSON as MD5)",
                  "pm.test(\"Verify MD5 Algorithm used in header\", function () {",
                  "    pm.expect(pm.request.auth.digest.get(\"algorithm\")).to.eql(\"MD5\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "digest",
              "digest": [
                {
                  "key": "username",
                  "value": "postman",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{digestAuth}}",
                  "type": "string"
                },
                {
                  "key": "algorithm",
