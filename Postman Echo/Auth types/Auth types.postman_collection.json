    {
      "name": "OAuth1.0",
      "item": [
        {
          "name": "New Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"OAuth 1.0 status check\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Verify that variables were substituted correctly\r",
                  "pm.test(\"Consumer Key is not empty\", function () {\r",
                  "    const consumerKey = pm.collectionVariables.get(\"consumerKey\");\r",
                  "    pm.expect(consumerKey).to.not.be.undefined;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Signature method is HMAC-SHA1\", function () {\r",
                  "    const authData = pm.request.auth.oauth1;\r",
                  "    const signature = authData.find(item => item.key === \"signatureMethod\");\r",
                  "    pm.expect(signature.value).to.equal(\"HMAC-SHA1\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BaseUrl}}oauth1",
              "host": [
                "{{BaseUrl}}oauth1"
              ]
            }
          },
          "response": []
        }
      ],
