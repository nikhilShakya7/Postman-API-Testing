    {
      "name": "Hawk Auth",
      "item": [
        {
          "name": "HawkAuth",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Hawk Auth request successful\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Verify the Authorization header was generated\r",
                  "pm.test(\"Authorization header is present\", function () {\r",
                  "    pm.expect(pm.request.headers.has(\"Authorization\")).to.be.true;\r",
                  "    pm.expect(pm.request.headers.get(\"Authorization\")).to.include(\"Hawk\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "hawk",
              "hawk": [
