          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Cookies removed successfully\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.cookies).to.not.have.property('foo1');\r",
              "    pm.expect(jsonData.cookies).to.not.have.property('foo2');\r",
              "});"
            ],
